{
  "name": "instanssi-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "build:production": "vite build -l error",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint src/ --fix",
    "format": "prettier --write vite.config.ts vitest.config.ts env.d.ts src/**/*.ts src/**/*.vue",
    "lint-check": "eslint src/",
    "format-check": "prettier -c vite.config.ts vitest.config.ts env.d.ts src/**/*.ts src/**/*.vue",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@formkit/drag-and-drop": "^0.5.3",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@instanssi/api": "file:../shared/api",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/vue": "^10.70.0",
    "chart.js": "^4.5.1",
    "lodash-es": "^4.18.1",
    "pdf-lib": "^1.17.1",
    "temporal-polyfill": "^0.3.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4",
    "vue-toastification": "2.0.0-rc.5",
    "vuetify": "^3.13.2",
    "vuetify-pro-tiptap": "^2.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
